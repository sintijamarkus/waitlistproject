# Nokopē šo failu uz .env.local un ieliec savas vērtības.
# Supabase → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publiskā atslēga (anon vai sb_publishable_...). To DRĪKST redzēt pārlūkā.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# service_role / secret atslēgu šai aplikācijai NEVAJAG. Nekad neliec to ar NEXT_PUBLIC_ priedēkli.
